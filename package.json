{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "npm run build:production",
    "build:production": "cross-env VITE_BUILD_TARGET=public VITE_DEPLOY_ENVIRONMENT=production VITE_CHECKOUT_ENABLED=false VITE_PADDLE_ENVIRONMENT=production VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true tsc -b && cross-env VITE_BUILD_TARGET=public VITE_DEPLOY_ENVIRONMENT=production VITE_CHECKOUT_ENABLED=false VITE_PADDLE_ENVIRONMENT=production VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true vite build --mode public",
    "build:staging": "cross-env VITE_BUILD_TARGET=public VITE_DEPLOY_ENVIRONMENT=staging VITE_CHECKOUT_ENABLED=true VITE_PADDLE_ENVIRONMENT=sandbox VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true tsc -b && cross-env VITE_BUILD_TARGET=public VITE_DEPLOY_ENVIRONMENT=staging VITE_CHECKOUT_ENABLED=true VITE_PADDLE_ENVIRONMENT=sandbox VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true vite build --mode staging",
    "build:private": "cross-env VITE_BUILD_TARGET=private VITE_STORE_WORKSHOP_ENABLED=true VITE_STORE_PRODUCT_HIERARCHY_ENABLED=true VITE_STORE_RELEASE_REPACK_ENABLED=true VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true node scripts/requirePrivateFirebaseEnv.mjs && cross-env VITE_BUILD_TARGET=private VITE_STORE_WORKSHOP_ENABLED=true VITE_STORE_PRODUCT_HIERARCHY_ENABLED=true VITE_STORE_RELEASE_REPACK_ENABLED=true VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true tsc -b && cross-env VITE_STORE_WORKSHOP_ENABLED=true VITE_STORE_PRODUCT_HIERARCHY_ENABLED=true VITE_STORE_RELEASE_REPACK_ENABLED=true VITE_STORE_READ_MODEL_ENABLED=true VITE_STORE_OFFER_CHECKOUT_ENABLED=true vite build --mode private",
    "deploy:docs": "node scripts/deployDistToDocs.mjs --mirror-root",
    "deploy:docs:public": "npm run build:public && node scripts/deployDistToDocs.mjs --target=public --mirror-root",
    "deploy:docs:private": "npm run build:private && node scripts/deployDistToDocs.mjs --target=private --mirror-root",
    "deploy:full:public": "node scripts/deployPublicFull.mjs",
    "deploy:full:private": "node scripts/deployPrivateFull.mjs",
    "scan:public-build": "node scripts/scanPublicBuildForSecrets.mjs dist",
    "deploy:staging": "node scripts/deployStaging.mjs",
    "prepare:hosting:staging": "npm run build:staging && node scripts/prepareFirebaseHosting.mjs --target=staging",
    "prepare:hosting:production": "npm run build:production && node scripts/prepareFirebaseHosting.mjs --target=production",
    "verify:environment-separation": "node scripts/verifyEnvironmentSeparation.mjs",
    "verify:public-bundle-size": "node scripts/verifyPublicBundleSize.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync-downloads": "tsx scripts/syncDownloads.ts",
    "regenerate": "tsx scripts/regenerate.ts",
    "rollback": "tsx scripts/rollback.ts",
    "investigation:capture": "node scripts/captureInvestigationRun.mjs",
    "investigation:create:pointer-zpk": "tsx scripts/createPointerSampleZpk.mjs",
    "investigation:validate:zpk": "node scripts/validateZpkParity.mjs",
    "investigation:validate:manifest": "node scripts/verifyAssetManifest.mjs",
    "investigation:validate:minimums": "node scripts/validateRunMinimums.mjs",
    "investigation:validate:sc001": "node scripts/validateSc001MatrixIntegrity.mjs",
    "investigation:validate:coverage": "node scripts/validateTwoDeviceClassCoverage.mjs",
    "investigation:validate:nonintrusive": "node scripts/checkInstrumentationNonIntrusive.mjs",
    "verify:digit-typography": "node scripts/verifyDigitTypography.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@paddle/paddle-js": "^1.6.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tabler/icons-react": "^3.41.1",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.6.1",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.70.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.2.2",
    "react-router-dom": "^7.14.1",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "canvas": "^3.2.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^12.0.0",
    "globals": "^16.5.0",
    "kimi-plugin-inspect-react": "^1.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.4"
  }
}
